# LLM (Ollama OpenAI-compatible API)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=your-key-here

# Groq (optional – chat fallback); never commit a real key
GROQ_API_KEY=your-groq-key-here
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_CHAT_MODEL=gemma2-9b-it
CHAT_MODEL=llama3.1:8b
EMBED_MODEL=nomic-embed-text
LLM_TIMEOUT_SECONDS=120
EMBED_TIMEOUT_SECONDS=30
OLLAMA_KEEP_ALIVE=30m
# REWRITER_MODEL=llama3.2:3b

# Guardrails (default off — restart server after changes)
# ENABLE_INPUT_GUARD=false
# ENABLE_RELEVANCE_GRADING=false
# ENABLE_OUTPUT_CHECK=false
# ENABLE_PROMPT_REORDER=false
# GRADE_MAX_CHUNKS=3
# GRADE_TIMEOUT_S=15
# GRADE_SKIP_SCORE=0.85
# MAX_QUESTION_CHARS=2000

# Frontend CORS (comma-separated list if your env loader supports it)
# ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# RAG
# CHROMA_PATH=./chroma_data
# MAX_UPLOAD_MB=10
# MAX_CHUNKS_PER_DOCUMENT=500
# CHUNK_SIZE=500
# CHUNK_OVERLAP=50
# TOP_K=5
# RAG_TOP_K=3
# MIN_SCORE=0.5
# REWRITE_HISTORY_TURNS=4
# CHAT_HISTORY_LIMIT=8
# CHAT_TEMPERATURE=0.2

# Rate limits (slowapi syntax)
# RATE_LIMIT_CHAT=20/minute
# RATE_LIMIT_UPLOAD=5/minute
# RATE_LIMIT_DEFAULT=60/minute